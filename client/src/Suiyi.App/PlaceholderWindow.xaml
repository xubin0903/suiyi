<Window x:Class="Suiyi.App.PlaceholderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="随译"
        Width="360"
        Height="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
  <StackPanel HorizontalAlignment="Center"
              VerticalAlignment="Center">
    <TextBlock HorizontalAlignment="Center"
               FontFamily="Microsoft YaHei UI, Segoe UI"
               FontSize="20"
               Text="M2 骨架" />
    <!-- 剪贴板监听手测用（#30），托盘 Issue（#29）移除占位窗口时一并删除。 -->
    <CheckBox x:Name="PauseCheckBox"
              Margin="0,16,0,0"
              Content="暂停剪贴板监听"
              Checked="OnPauseChanged"
              Unchecked="OnPauseChanged" />
    <Button Margin="0,8,0,0"
            Padding="8,2"
            Content="写入测试文本（不应触发）"
            Click="OnWriteTestText" />
    <!-- 快捷键手测用（#33）：显示注册状态，可改快捷键并调用 HotkeyManager.Update。随占位窗口一并删除。 -->
    <TextBlock x:Name="HotkeyStatusText"
               Margin="0,16,0,0"
               MaxWidth="320"
               TextWrapping="Wrap" />
    <StackPanel Margin="0,8,0,0"
                Orientation="Horizontal">
      <TextBox x:Name="HotkeyTextBox"
               Width="160" />
      <Button Margin="8,0,0,0"
              Padding="8,2"
              Content="应用快捷键"
              Click="OnApplyHotkey" />
    </StackPanel>
    <!-- 翻译服务状态手测用（#32），托盘（#29）接管后删除。 -->
    <TextBlock x:Name="EngineStateText"
               MaxWidth="320"
               Margin="0,16,0,0"
               TextWrapping="Wrap"
               Text="翻译服务：Stopped" />
    <Button Margin="0,8,0,0"
            Padding="8,2"
            Content="重启翻译服务"
            Click="OnRestartEngine" />
  </StackPanel>
</Window>
