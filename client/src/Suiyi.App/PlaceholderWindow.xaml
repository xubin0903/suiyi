<Window x:Class="Suiyi.App.PlaceholderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="随译"
        Width="360"
        Height="220"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
  <StackPanel HorizontalAlignment="Center"
              VerticalAlignment="Center">
    <TextBlock HorizontalAlignment="Center"
               FontFamily="Microsoft YaHei UI, Segoe UI"
               FontSize="20"
               Text="M2 骨架" />
    <!-- 剪贴板监听手测用（#30），托盘 Issue（#29）移除占位窗口时一并删除。 -->
    <CheckBox x:Name="PauseCheckBox"
              Margin="0,16,0,0"
              Content="暂停剪贴板监听"
              Checked="OnPauseChanged"
              Unchecked="OnPauseChanged" />
    <Button Margin="0,8,0,0"
            Padding="8,2"
            Content="写入测试文本（不应触发）"
            Click="OnWriteTestText" />
  </StackPanel>
</Window>
